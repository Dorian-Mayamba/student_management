<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1">

  <left>
    <VBox prefHeight="600.0" prefWidth="250.0" style="-fx-background-color: #42b866;" BorderPane.alignment="CENTER">
      <children>
        <Label text="Student Management" textFill="WHITE">
          <font>
            <Font name="System Bold" size="20.0" />
          </font>
        </Label>
      </children>
      <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="40.0" />
      </padding>
    </VBox>
  </left>

  <center>
    <VBox prefHeight="200.0" prefWidth="100.0" spacing="15.0" BorderPane.alignment="CENTER">
      <children>
            <HBox prefHeight="47.0" prefWidth="610.0">
               <children>
              <Label text="Students List" textFill="#333333">
                <font>
                  <Font name="System Bold" size="24.0" />
                </font>
              </Label>
                  <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                  <Button fx:id="addButton" alignment="CENTER" mnemonicParsing="false" onAction="#showAddStudentDialog" prefHeight="25.0" prefWidth="117.0" text="Add Student">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>

        <TableView fx:id="table" prefHeight="509.0" prefWidth="673.0" VBox.vgrow="ALWAYS">
          <columns>
            <TableColumn fx:id="studentId" prefWidth="100.0" text="Student ID" />
            <TableColumn fx:id="studentName" prefWidth="112.0" text="Name" />
            <TableColumn fx:id="studentEmail" prefWidth="112.0" text="Email" />
            <TableColumn fx:id="ageCol" prefWidth="107.0" text="Age" />
            <TableColumn fx:id="delete" prefWidth="89.0" text="Delete" />
            <TableColumn fx:id="edit" prefWidth="89.0" text="Edit" />
          </columns>
        </TableView>
      </children>
      <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
      </padding>
    </VBox>
  </center>
</BorderPane>
